<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net8.0-windows, not net8.0: the tray icon is WinForms' NotifyIcon.
         Hand-rolled Shell_NotifyIcon interop would keep the portable target,
         but Windows-only is already the decision, so it would be work spent
         defending a door nobody is going through. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EtaSignAgent</RootNamespace>
    <AssemblyName>eksigner</AssemblyName>
    <Version>1.3.0</Version>

    <!-- Unsigned is not the same as anonymous. These populate the version
         resource, so Properties → Details names the publisher instead of
         showing a blank pane. -->
    <Company>Eickter Software &amp; Supplies</Company>
    <Product>ekSigner</Product>
    <Description>Seals ETA e-invoices using your e-seal token</Description>
    <Copyright>© 2026 Eickter Software &amp; Supplies</Copyright>
    <ApplicationIcon>eksigner.ico</ApplicationIcon>
    <!-- Must match the vendor PKCS#11 module: a 64-bit process cannot load a
         32-bit DLL. Both verified modules are 64-bit. -->
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- No console window. The agent starts at login and runs all day; a black
         terminal sitting on the taskbar invites someone to close it. The
         pairing code and token state live on the agent's own page instead —
         see StatusPage.cs. -->
    <OutputType>WinExe</OutputType>

    <!-- Publish defaults, so releasing is `dotnet publish -c Release`.
         Self-contained because a tenant cannot be asked to install a .NET
         runtime first. Windows-only by decision: the macOS PKCS#11 paths in
         AgentConfig came from vendor documentation, never from a machine with
         a token in it.

         NOT single-file, deliberately. Self-contained plus PublishSingleFile
         produces a ~70 MB executable that unpacks itself at startup, and
         wrapping that in an lzma2/max solid-compressed installer gives the
         finished download the shape of a packed dropper. Defender was deleting
         it on arrival. Shipping the runtime as loose DLLs costs a bigger
         install directory and nothing else — installer/eksigner.iss already
         globs the whole publish folder, precisely because the emitted file
         count was known to vary by SDK version. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Not trimmed: minimal APIs and System.Text.Json resolve types by
         reflection, and a trimmed build fails at runtime, not at build time. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- The Web SDK publishes IIS hosting assets — web.config and the ANCM
         shim. This is a desktop agent that will never sit behind IIS, and a
         web.config in a shop's install folder is only a thing to wonder about. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pkcs11Interop" Version="5.1.2" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

</Project>
